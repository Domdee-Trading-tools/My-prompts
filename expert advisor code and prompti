//--- Input parameters
input int      SwingLookback = 50;           // Bars to look for swing levels
input int      SwingStrength = 3;            // Swing strength (bars each side)
input double   BreakoutBuffer = 10;          // Buffer in points for breakout zone
input bool     ShowLabels = true;            // Show level labels
input bool     ShowBreakoutArrows = true;    // Show breakout arrows
input int      DaysToShow = 10;              // Number of days to display

//--- Structure to hold daily data
struct DayData
{
   datetime start_time;
   datetime end_time;
   double   range_high;        // Previous day's high
   double   range_low;         // Previous day's low
   double   swing_high;        // Next level above RangeHigh
   double   swing_low;         // Next level below RangeLow
   bool     breakout_detected;
   int      breakout_direction; // 1 = up, -1 = down
   datetime breakout_time;
   int      color_index;
};

DayData daily_data[];
int     total_days = 0;

//--- Color palette for rectangles (very transparent)
color rectangle_colors[] = 
{
   C'173,216,230',  // Light Blue
   C'144,238,144',  // Light Green
   C'255,182,193',  // Light Pink
   C'255,218,185',  // Peach
