//+------------------------------------------------------------------+
//| Delete all objects created by indicator                          |
//+------------------------------------------------------------------+
void DeleteAllObjects()
{
   int obj_total = ObjectsTotal(0);
   
   for(int i = obj_total - 1; i >= 0; i--)
   {
      string obj_name = ObjectName(0, i);
      
      if(StringFind(obj_name, "PrevDayRect_") >= 0 ||
         StringFind(obj_name, "CurrDayRect_") >= 0 ||
         StringFind(obj_name, "SwingHigh_") >= 0 ||
         StringFind(obj_name, "SwingLow_") >= 0 ||
         StringFind(obj_name, "RangeHigh_") >= 0 ||
         StringFind(obj_name, "RangeLow_") >= 0 ||
         StringFind(obj_name, "LblSH_") >= 0 ||
         StringFind(obj_name, "LblSL_") >= 0 ||
         StringFind(obj_name, "BreakUp_") >= 0 ||
         StringFind(obj_name, "BreakDown_") >= 0)
      {
         ObjectDelete(0, obj_name);
      }
   }
   
   ChartRedraw();
}
